{
  "gameId": "01-chamber-of-secrets",
  "title": "密室：记忆碎片",
  "description": "一场关于记忆与欺骗的博弈",
  "startNode": "node_001",
  "nodes": {
    "node_001": {
      "id": "node_001",
      "type": "dialogue",
      "content": "你醒来时，头痛欲裂。昏暗的书房里只有壁炉的微光，空气中弥漫着旧纸张的味道。你完全想不起自己是怎么来到这里的。",
      "choices": [
        {
          "id": "choice_001",
          "text": "环顾四周",
          "nextNode": "node_002"
        }
      ]
    },
    "node_002": {
      "id": "node_002",
      "type": "dialogue",
      "content": "书桌上放着一张字条，字迹潦草：「钥匙藏在你最信任的人手里。」桌角还有一枚生锈的怀表，表盖内侧刻着几个数字。",
      "choices": [
        {
          "id": "choice_002a",
          "text": "查看怀表",
          "nextNode": "node_003",
          "effects": [{ "type": "addItem", "key": "rusty_watch", "value": "生锈的怀表" }]
        },
        {
          "id": "choice_002b",
          "text": "先检查门是否上锁",
          "nextNode": "node_004"
        }
      ]
    },
    "node_003": {
      "id": "node_003",
      "type": "dialogue",
      "content": "怀表内侧刻着「14」。你把它记在心里，收好怀表，转身走向房门。",
      "nextNode": "node_004"
    },
    "node_004": {
      "id": "node_004",
      "type": "puzzle",
      "content": "房门上有一个四位数密码锁。你隐约记得那张字条和怀表似乎有关联……",
      "puzzleId": "code-lock-demo",
      "choices": [
        {
          "id": "choice_004_correct",
          "text": "输入 0014 并尝试打开",
          "nextNode": "node_005",
          "conditions": [{ "type": "hasItem", "key": "rusty_watch" }]
        },
        {
          "id": "choice_004_wrong",
          "text": "随便输入几个数字试试",
          "nextNode": "node_004_fail"
        }
      ]
    },
    "node_004_fail": {
      "id": "node_004_fail",
      "type": "dialogue",
      "content": "锁没有反应。看来需要更确切的线索。",
      "nextNode": "node_004"
    },
    "node_005": {
      "id": "node_005",
      "type": "cutscene",
      "content": "门缓缓打开。门外的走廊墙上挂满了你的照片——原来这场密室，从一开始就是你自己设计的局。",
      "effects": [{ "type": "setFlag", "key": "chapter1_truth_revealed", "value": true }],
      "choices": [
        {
          "id": "choice_005",
          "text": "继续向前",
          "nextNode": "node_ending"
        }
      ]
    },
    "node_ending": {
      "id": "node_ending",
      "type": "ending",
      "content": "你拾起地上的「记忆水晶」，它微微发光，仿佛记录着某个未完成的约定。这段记忆碎片，将被带往下一段旅程……",
      "effects": [
        { "type": "addItem", "key": "memory_crystal", "value": "记忆水晶" }
      ]
    }
  }
}
