# 复制为 .env 并填写真实值

# PostgreSQL 连接串
DATABASE_URL="postgresql://floo_user:your_password@localhost:5432/floo_db"

# JWT 签名密钥（随机长字符串，不要泄露）
JWT_SECRET="change-this-to-a-long-random-secret"

# 服务端口（不要和现有服务冲突）
PORT=3001

# 前端地址，用于 CORS 白名单（多个用逗号分隔）
CORS_ORIGIN="https://your-frontend-domain.com,http://localhost:5173"
